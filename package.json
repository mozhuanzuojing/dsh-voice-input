{
  "name": "dsh-voice-input",
  "version": "0.6.0",
  "description": "聊天框语音输入按钮 for DeepSeek Harness(本地改造版):支持 Web Speech API(Chrome/Edge 免 key 实时)与 Gemini 等服务端 ASR,点击麦克风说话自动填入输入框。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "audio",
    "asr",
    "webspeech",
    "speech",
    "transcribe",
    "voice",
    "mic"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "esbuild src/client.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=lib/client.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "author": "mozhuanzuojing",
  "repository": {
    "url": "https://github.com/mozhuanzuojing/dsh-voice-input.git",
    "type": "git"
  },
  "homepage": "https://github.com/mozhuanzuojing/dsh-voice-input#readme",
  "bugs": {
    "url": "https://github.com/mozhuanzuojing/dsh-voice-input/issues"
  }
}
